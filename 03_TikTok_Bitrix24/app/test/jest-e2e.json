{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "setupFiles": ["<rootDir>/disable-external-sync.cjs"],
  "globalSetup": "<rootDir>/prepare-isolated-db.cjs",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": { "rootDir": "." } }]
  }
}
