# Development only. Keep real credentials in .env, which Git ignores.
DB_HOST=127.0.0.1
DB_PORT=15432
DB_USER=tiktok_app
DB_PASSWORD=local_dev_only
DB_NAME=tiktok_bitrix
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
MOCK_TIKTOK_WEBHOOK_SECRET=replace-with-a-long-random-local-secret
ADMIN_API_KEY=replace-with-another-long-random-local-key
# Private inbound webhook base URL. Never share or commit it.
BITRIX_WEBHOOK_URL=https://<domain-của-bạn>/rest/<user-id>/<mã-mới>/
# Set true only after migration and a successful bitrix:check. This permits real CRM writes.
BITRIX_SYNC_ENABLED=false
BITRIX_DEAL_CATEGORY_ID=0
